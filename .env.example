# DMR-X environment template
# Copy to .env for local development. Never commit real secrets.

# REQUIRED in production: Node runtime mode. Example: production
NODE_ENV=development

# OPTIONAL: Gateway listen port. Default: 3000
PORT=3000

# OPTIONAL: Logger level. Default: info
LOG_LEVEL=info

# OPTIONAL: Directory for local SQLite/data files. Default: process working directory
DMRX_DATA_DIR=.data

# OPTIONAL: Static UI directory served by the gateway. Default: apps/gateway/public after build
DMRX_UI_DIR=apps/gateway/public

# OPTIONAL: Enable single-user local mode and skip tenant API key auth. Default: false
DMRX_LOCAL_MODE=true

# REQUIRED unless DMRX_LOCAL_MODE=true: admin key for /v1/admin/*.
DMRX_ADMIN_API_KEY=replace-with-admin-key

# OPTIONAL: CORS origin for the gateway. Default: *
DMRX_CORS_ORIGIN=*

# OPTIONAL: Rate limit max requests for the Fastify gateway. Default: 100
DMRX_RATE_LIMIT_MAX=100

# OPTIONAL: Rate limit window for the Fastify gateway. Default: 1 minute
DMRX_RATE_LIMIT_WINDOW=1 minute

# OPTIONAL: Free-tier routing strategy. Values: none, prioritize, load_balance, fallback
DMRX_FREE_TIER_STRATEGY=none

# OPTIONAL: Browser API base for the Vite UI. Empty means same origin.
VITE_API_BASE=

# OPTIONAL: OpenAI-compatible provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# OPTIONAL: Anthropic provider settings.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPTIONAL: Local Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434

# OPTIONAL: Replicate API token.
REPLICATE_API_TOKEN=

# OPTIONAL: Stability AI settings.
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai

# OPTIONAL: Audio provider keys.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# OPTIONAL: Cohere and Jina provider keys.
COHERE_API_KEY=
JINA_API_KEY=

# OPTIONAL: Additional provider keys supported by the provider catalog.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
ZHIPU_API_KEY=
UPSTAGE_API_KEY=
SCALEWAY_API_KEY=
HF_TOKEN=
VOYAGE_API_KEY=
VLLM_BASE_URL=http://localhost:8000
LLAMACPP_BASE_URL=http://localhost:8080
GITHUB_TOKEN=
CLOUDFLARE_AI_TOKEN=

# OPTIONAL: MCP server transport. Values: stdio, sse, http. Default: stdio
DMRX_MCP_TRANSPORT=stdio

# OPTIONAL: MCP HTTP/SSE port. Default: 3100
DMRX_MCP_PORT=3100

# OPTIONAL: MCP HTTP/SSE host. Default: 0.0.0.0
DMRX_MCP_HOST=0.0.0.0
