# DMR-X environment template
# Copy to .env for local development. Never commit real secrets.

# REQUIRED in production: Node runtime mode. Example: production
NODE_ENV=development

# OPTIONAL: Gateway listen port. Default: 3000
PORT=3000

# OPTIONAL: Logger level. Default: info
LOG_LEVEL=info

# OPTIONAL: Directory for local SQLite/data files. Default: ~/.dmr-x
# The gateway uses this for its encrypted provider database.
DMRX_DATA_DIR=.data

# NOTE: The MCP server (if running separately) uses DMRX_DATA_DIR to determine its
# database location. If DMRX_DATA_DIR is unset, the MCP server isolates its database
# to ~/.dmr-x/mcp to avoid contending with the gateway's encrypted DB file lock.
# Set DMRX_DATA_DIR explicitly if you need both processes to use different directories.

# OPTIONAL: Static UI directory served by the gateway. Default: apps/gateway/public after build
DMRX_UI_DIR=apps/gateway/public

# OPTIONAL: Enable single-user local mode and skip tenant API key auth.
# Set to "true" for local development so `cp .env.example .env` + run boots
# without a real admin key; always "false" in production.
DMRX_LOCAL_MODE=true

# REQUIRED unless DMRX_LOCAL_MODE=true: admin key for /v1/admin/*.
# Ignored while DMRX_LOCAL_MODE=true. If you switch to false, replace this
# placeholder with a real key (>= 32 chars) or the gateway refuses to start.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DMRX_ADMIN_API_KEY=replace-with-admin-key

# OPTIONAL: AES-256-GCM key for encrypting provider API keys at rest (64 hex chars).
# If unset, provider keys are stored in plaintext (dev only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DMRX_ENCRYPTION_KEY=

# OPTIONAL: CORS origin for the gateway. Default: local development origins.
# REQUIRED in production: set this to your actual UI origin(s).
# Comma-separated list of origins is supported.
DMRX_CORS_ORIGIN=http://localhost:4200

# OPTIONAL: Rate limit max requests for the Fastify gateway. Default: 600
DMRX_RATE_LIMIT_MAX=600

# OPTIONAL: Rate limit window for the Fastify gateway. Default: 1 minute
DMRX_RATE_LIMIT_WINDOW=1 minute

# OPTIONAL: Data retention period in days. Records older than this are pruned.
# Applies to request_logs, usage_records, messages, and admin_audit_log.
# Set to 0 to disable pruning. Default: 30
DMRX_DATA_RETENTION_DAYS=30

# OPTIONAL: Max JSON request body size. Default: 10mb. Accepts "10mb", "1024kb", or plain bytes.
DMRX_BODY_LIMIT=10mb

# OPTIONAL: Request timeout in ms. Default: 60000 (60s). Streaming responses are not affected.
DMRX_REQUEST_TIMEOUT=60000

# OPTIONAL: HTTP keep-alive timeout in ms. Default: 65000 (65s). Should match your reverse proxy.
DMRX_KEEPALIVE_TIMEOUT=65000

# OPTIONAL: Connection timeout in ms (slow-loris defense). Default: 10000 (10s).
DMRX_CONNECTION_TIMEOUT=10000

# OPTIONAL: Max URL-encoded path/query parameter length. Default: 200.
DMRX_MAX_PARAM_LENGTH=200

# OPTIONAL: Trust X-Forwarded-* from these sources. Default: loopback.
# Values: true | false | loopback | linklocal | uniquelocal | <CIDR> | <IP list>
# Set to "true" if behind nginx/Cloudflare/etc.
DMRX_TRUST_PROXY=loopback

# OPTIONAL: RSS threshold for /healthz memory check. Default: 1.5gb.
# Accepts "1.5gb", "512mb", or plain bytes.
DMRX_MEMORY_LIMIT=1.5gb

# OPTIONAL: Response compression threshold in bytes. Default: 1024 (1 KB).
# Responses smaller than this are sent uncompressed to avoid the CPU cost
# of compressing tiny JSON envelopes. Set to 0 to disable compression.
# SSE streams are skipped regardless of this setting.
DMRX_COMPRESS_THRESHOLD=1024

# OPTIONAL: Free-tier routing strategy. Values: none, prioritize, load_balance, fallback
DMRX_FREE_TIER_STRATEGY=none
# OPTIONAL: Hard allowlist of provider NAMES the router may use. Comma-separated.
# LEAVE UNSET to route to every keyed, healthy provider — that is the default and
# almost always what you want.
#
# When set, this is a hard cap applied in the registry query BEFORE any routing
# logic runs, so no scoring, fallback or meta-model can reach a provider missing
# from the list. It is the FIRST thing to check when `auto` keeps electing the
# same one or two providers: on one deployment a stale 5-name list pinned the
# router to 253 of 815 models (31%) and hid 525 models on providers that had
# working keys, which starved the fallback chain and turned any single upstream
# hiccup into a 502.
#
# Names must match the provider `name` column exactly (see /v1/admin/providers).
# An entry with no active key is dead weight — it can never serve a request, so
# prune it instead of leaving it in the list.
# DMRX_PROVIDER_ALLOWLIST=google,openrouter-free,nvidia-nim,opencode-zen

# OPTIONAL: Provider NAMES whose configured key is a free-tier key.
# Comma-separated. This declares the KEY is free — NOT that every model the
# provider sells is free. A model with a positive published price is still
# treated as paid, so free-only aliases cannot elect a paid flagship and then
# fail on that provider's billing error ("No payment method", "Insufficient
# credits").
# DMRX_FREE_PROVIDERS=openrouter-free,codestral-free,nvidia-nim


# OPTIONAL: Browser API base for the Vite UI. Empty means same origin.
VITE_API_BASE=

# OPTIONAL: OpenAI-compatible provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# OPTIONAL: Anthropic provider settings.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPTIONAL: Local Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434

# OPTIONAL: Ollama Cloud (hosted models at ollama.com).
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# OPTIONAL: Replicate API token.
REPLICATE_API_TOKEN=

# OPTIONAL: Stability AI settings.
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai

# OPTIONAL: Audio provider keys.
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# OPTIONAL: Audio separation provider keys.
AUDIO_SHAKE_API_KEY=
DMRX_AUDIO_SHAKE_BASE_URL=https://api.audioshake.com/v1
STEMSPLIT_API_KEY=
DMRX_STEMSPLIT_BASE_URL=https://api.stemsplit.com/v1
DMRX_DEMUCS_BASE_URL=http://localhost:8000

# OPTIONAL: OCR provider keys.
TESSERACT_BASE_URL=
PADDLEOCR_BASE_URL=
PADDLEOCR_API_KEY=
HF_INFERENCE_URL=http://localhost:8000

# OPTIONAL: Video generation provider keys.
FAL_KEY=                         # FAL.ai (Seedance 2.0, Wan 2.7, Kling 3.0)
RUNWAY_API_KEY=                  # RunwayML (Gen-4.5, Seedance, Veo)
LUMA_API_KEY=                    # Luma Dream Machine (Ray 3.2/2)
# OPENAI_API_KEY already used for LLM; also handles Sora 2 video
# GOOGLE_API_KEY already used for LLM; also handles Veo 3.1 video
# MINIMAX_API_KEY already used for LLM; also handles Hailuo video
# DASHSCOPE_API_KEY already used for Qwen; also handles Wan video

# OPTIONAL: Cohere and Jina provider keys.
COHERE_API_KEY=
JINA_API_KEY=

# OPTIONAL: Additional provider keys supported by the provider catalog.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=
# OpenRouter free models have a built-in 1,000 requests/day hard cap.
# Override via PROVIDER_DAILY_CAP_OPENROUTER=5000 (set to 0 to disable cap entirely).
# WARNING: OpenRouter's free tier is rate-limited at 20 RPM regardless of daily cap.
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
ZHIPU_API_KEY=
UPSTAGE_API_KEY=
SCALEWAY_API_KEY=
HF_TOKEN=
VOYAGE_API_KEY=
VLLM_BASE_URL=http://localhost:8000
LLAMACPP_BASE_URL=http://localhost:8080
GITHUB_TOKEN=
CLOUDFLARE_AI_TOKEN=

# OPTIONAL: Self-hosted specialized providers
TEI_BASE_URL=http://localhost:8090           # Text Embeddings Inference (embeddings + reranking)
PIPER_BASE_URL=http://localhost:5000         # Piper TTS (local text-to-speech)
KOKORO_BASE_URL=http://localhost:8880        # Kokoro TTS (local text-to-speech)
ORPHEUS_BASE_URL=http://localhost:5005       # Orpheus TTS (emotional expression)
FASTER_WHISPER_BASE_URL=http://localhost:8000 # Faster-Whisper ASR (local speech-to-text)
ULTRALYTICS_BASE_URL=http://localhost:8080   # Ultralytics YOLO (local vision/detection)

# OPTIONAL: ComfyUI local video generation instance
# Point to your local ComfyUI instance (default http://localhost:8188)
# DMR-X routes video generation requests to ComfyUI first (local-first),
# then falls back to cloud providers like Replicate, Runway, Fal, etc.
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_MAX_CONCURRENT=1

# OPTIONAL: Higgsfield Supercomputer MCP aggregation
# Uncomment to aggregate Higgsfield's MCP server into DMR-X.
# This exposes 30+ video/image models (Seedance 2.0, Kling 3.0, Veo 3.1, Sora 2, etc.)
# as namespaced MCP tools (higgsfield__generate_video, higgsfield__generate_image, etc.).
# Requires a Higgsfield account; auth is OAuth.
# DMRX_MCP_CLIENT_SERVERS='[{"id":"higgsfield","name":"Higgsfield","transport":"sse","url":"https://mcp.higgsfield.ai/mcp"}]'

# OPTIONAL: MCP server transport. Values: stdio, sse, http. Default: stdio
DMRX_MCP_TRANSPORT=stdio

# OPTIONAL: MCP HTTP/SSE port. Default: 47114
DMRX_MCP_PORT=47114

# OPTIONAL: MCP HTTP/SSE host. Default: 127.0.0.1
# SECURITY: Use 0.0.0.0 only if you need remote access; prefer 127.0.0.1 (localhost only).
DMRX_MCP_HOST=127.0.0.1

# OPTIONAL: MCP HTTP/SSE auth. Comma-separated for multiple keys.
# Required when DMRX_MCP_TRANSPORT is sse or http in production.
DMRX_MCP_API_KEY=

# OPTIONAL: MCP CORS origin for SSE/HTTP transports. Default: local development origins.
DMRX_MCP_CORS_ORIGIN=

# OPTIONAL: MCP rate limit. Default: 100
DMRX_MCP_RATE_LIMIT=100

# OPTIONAL: MCP session timeout in ms. Default: 300000 (5 min)
DMRX_MCP_SESSION_TIMEOUT_MS=300000

# OPTIONAL: MCP upstream timeout in ms. Default: 30000 (30 s)
DMRX_MCP_UPSTREAM_TIMEOUT_MS=30000

# OPTIONAL: MCP upstream max retries. Default: 2
DMRX_MCP_UPSTREAM_MAX_RETRIES=2

# OPTIONAL: MCP circuit breaker. Open after N consecutive failures, close after N ms.
DMRX_MCP_CIRCUIT_BREAKER_THRESHOLD=5
DMRX_MCP_CIRCUIT_BREAKER_TIMEOUT_MS=30000

# OPTIONAL: MCP max body size in bytes. Default: 10485760 (10 MB)
DMRX_MCP_MAX_BODY_BYTES=10485760

# OPTIONAL: MCP server config file path. If unset, only env vars are used.
DMRX_MCP_CONFIG=

# OPTIONAL: Auto-start the MCP HTTP server (+ A2A agent card) when the gateway
# boots. Default: true. Set false if an external supervisor owns :47114.
DMRX_MCP_AUTOSTART=true

# OPTIONAL: Enable A2A on the MCP sidecar (default true when MCP autostarts).
# DMRX_A2A_ENABLED=true
# DMRX_A2A_AGENT_URL=http://127.0.0.1:47114

# ============================================================================
# G0DM0D3 Integration (Optional)
# ============================================================================
# G0DM0D3 provides advanced AI features:
# - ULTRAPLINIAN: Multi-model racing (10-55 models)
# - CONSORTIUM: Hive-mind synthesis
# - AutoTune: Context-adaptive parameter tuning
# - Parseltongue: Trigger word obfuscation
# - STM Modules: Semantic text transformation

# OPTIONAL: Auto-start the local G0DM0D3 proxy when the gateway boots (relay
# mode through DMR-X's own vault). Default: false — strictly opt-in, because
# enabling it makes the gateway clone and execute a third-party GitHub repo on
# boot. Set true only if you want that; otherwise start it deliberately with a
# manual POST /v1/godmode/server/start.
DMRX_GODMODE_AUTOSTART=false

# OPTIONAL: Repo the managed G0DM0D3 server is cloned from. Default: DMR-X's
# own fork (danny-dis/G0DM0D3), not upstream elder-plinius/G0DM0D3 — the fork
# is what .github/workflows/godmode-fork-sync.yml pulls upstream changes into
# nightly, on a schedule we control.
DMRX_GODMODE_REPO=https://github.com/danny-dis/G0DM0D3.git

# OPTIONAL: The project the repo above is a fork of. Shown in the UI and
# returned by GET /v1/godmode/server/updates so you can see how far the pinned
# commit trails upstream. Only change if DMRX_GODMODE_REPO points at a fork of
# a different project.
DMRX_GODMODE_UPSTREAM=https://github.com/elder-plinius/G0DM0D3

# OPTIONAL: Commit SHA (or branch/tag) the clone is pinned to. Default is a
# pinned commit, not a moving branch tip, so every fresh install gets
# identical source. Override to a branch name (e.g. "main") for local
# development against the fork's latest, or to a newer SHA after running
# scripts/dev/sync-godmode-fork.* to pull upstream changes.
DMRX_GODMODE_REF=f6301765fb90eb7b336bdf365319cd2fe44b1187

# OPTIONAL: G0DM0D3 API base URL. Default: http://localhost:47115
# Set this if you're running a G0DM0D3 API server
GODMODE_API_URL=http://localhost:47115

# OPTIONAL: G0DM0D3 API key for authentication
# Only needed if your G0DM0D3 instance requires auth
GODMODE_API_KEY=

# OPTIONAL: OpenRouter API key for G0DM0D3
# Required for G0DM0D3 to route requests to models via OpenRouter
# If not set, uses the global OPENROUTER_API_KEY
GODMODE_OPENROUTER_API_KEY=
