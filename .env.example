# DMR-X Configuration
# Copy this file to .env and fill in your values

# ─── Core Infrastructure ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://dmrx:dmrx@localhost:5432/dmr_x
REDIS_URL=redis://localhost:6379

# ─── Admin API ───────────────────────────────────────────────────────────────
# Required to access /v1/admin/* endpoints (creating tenants, API keys, etc.)
DMRX_ADMIN_API_KEY=your-admin-key-here

# ─── Gateway Settings ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
DMRX_RATE_LIMIT_MAX=100
DMRX_RATE_LIMIT_WINDOW=1 minute
DMRX_CORS_ORIGIN=*
DMRX_FREE_TIER_STRATEGY=round-robin

# ─── Provider API Keys ───────────────────────────────────────────────────────
# Only set the keys for providers you want to use.

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
XIAOMI_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
ZHIPU_API_KEY=
UPSTAGE_API_KEY=
CODESTRAL_API_KEY=
SCALEWAY_API_KEY=
INFERENCE_NET_API_KEY=
NLPCLOUD_API_KEY=
ALIBABA_CLOUD_API_KEY=
OPENCODE_ZEN_API_KEY=
LLM7_API_KEY=
KILO_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Image/Diffusion Providers
REPLICATE_API_TOKEN=
HF_TOKEN=
STABILITY_API_KEY=
