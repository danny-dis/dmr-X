  },
  "dependencies": {
    "pg": "^8.12.0",
    "redis": "^4.6.0",
    "@dmr-x/utils": "*"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.4.0"
  }
}
