{
  "name": "@dmr-x/db",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/clean-src-artifacts.ts && tsc -b",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "generate-migrations": "bun run scripts/generate-migrations-data.ts"
  },
  "dependencies": {
    "@dmr-x/utils": "*",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@types/sql.js": "1.4.11",
    "typescript": "5.9.3"
  }
}
