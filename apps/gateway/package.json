{
  "name": "@dmr-x/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "bun build --compile src/main.ts --outfile dist/dmrx.exe && bun run copy-public",
    "build:exe:linux": "bun build --compile --target=bun-linux-x64 src/main.ts --outfile dist/dmrx-linux && bun run copy-public",
    "build:exe:macos": "bun build --compile --target=bun-darwin-x64 src/main.ts --outfile dist/dmrx-darwin && bun run copy-public",
    "build:exe:all": "bun run build:exe && bun run build:exe:linux && bun run build:exe:macos",
    "copy-public": "node -e \"const fs=require('fs'),p=require('path');function c(s,d){fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s,{withFileTypes:true})){const sp=p.join(s,e.name),dp=p.join(d,e.name);e.isDirectory()?c(sp,dp):fs.copyFileSync(sp,dp)}}c('public','dist/public')\"",
    "package": "bash ../../scripts/package-release.sh",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dmr-x/adapters": "*",
    "@dmr-x/core": "*",
    "@dmr-x/db": "*",
    "@dmr-x/federation": "*",
    "@dmr-x/memory": "*",
    "@dmr-x/oauth": "*",
    "@dmr-x/policy": "*",
    "@dmr-x/quota": "*",
    "@dmr-x/registry": "*",
    "@dmr-x/router": "*",
    "@dmr-x/sandbox": "*",
    "@dmr-x/utils": "*",
    "@dmr-x/workers": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
