{
  "name": "dmr-x",
  "version": "0.1.0",
  "private": true,
  "description": "Universal AI routing and orchestration platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:gateway": "npm run dev --workspace=@dmr-x/gateway",
    "dev:ui": "npm run dev --workspace=@dmr-x/ui",
    "build": "turbo build",
    "build:ui": "npm run build --workspace=@dmr-x/ui",
    "start": "npm run start --workspace=@dmr-x/gateway",
    "start:bun": "bun run --cwd apps/gateway src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.0.0",
    "turbo": "2.5.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vitest": "3.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.0.0"
}
