{
  "name": "dmr-x",
  "version": "0.5.12",
  "private": true,
  "type": "module",
  "description": "Universal AI routing and orchestration platform",
  "license": "GPL-2.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run clean:src && turbo dev",
    "dev:gateway": "bun --watch apps/gateway/src/main.ts",
    "dev:ui": "bun run --cwd apps/ui dev",
    "build": "bun run clean:src && turbo build",
    "build:ui": "bun run --cwd apps/ui build",
    "start": "bun run --cwd apps/gateway start",
    "test": "bun run clean:src && bun vitest run",
    "test:unit": "bun run clean:src && bun vitest run --project unit",
    "test:e2e": "bun run clean:src && bun vitest run --project e2e",
    "test:ui": "bun vitest run --project ui",
    "test:coverage": "bun run clean:src && bun vitest run --project unit --coverage",
    "test:watch": "bun vitest",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "mcp:catalog:check": "bun run scripts/generate-mcp-catalog.ts --check",
    "mcp:catalog:gen": "bun run scripts/generate-mcp-catalog.ts",
    "clean": "bun run clean:src && turbo clean",
    "clean:src": "bun run scripts/clean-src-artifacts.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@types/inquirer": "9.0.9",
    "eslint": "9.17.0",
    "globals": "^15.14.0",
    "turbo": "2.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "6.4.3",
    "vitest": "^3.2.6",
    "@vitejs/plugin-react": "5.1.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@opentelemetry/context-async-hooks": "2.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "undici": "^6.28.0",
    "brace-expansion": "^1.1.17",
    "find-my-way": "^9.7.0",
    "@opentelemetry/propagator-jaeger": ">=2.9.0",
    "postcss": "^8.5.18",
    "protobufjs": "^7.5.4",
    "tmp": "^0.2.6",
    "vite": "6.4.3",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18"
  }
}
