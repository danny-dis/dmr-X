{
  "name": "dmr-x",
  "version": "0.1.0",
  "private": true,
  "description": "Universal AI routing and orchestration platform",
  "license": "BSL-1.1",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:gateway": "bun --watch apps/gateway/src/main.ts",
    "dev:ui": "bun run --cwd apps/ui dev",
    "build": "turbo build && bun run --cwd apps/ui build",
    "build:ui": "bun run --cwd apps/ui build",
    "start": "bun run --cwd apps/gateway start",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/inquirer": "^9.0.9",
    "turbo": "2.5.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vitest": "3.1.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.2.0",
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^2.7.1"
  }
}
