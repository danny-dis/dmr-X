{
  "name": "dmr-x",
  "version": "0.5.3",
  "private": true,
  "description": "Universal AI routing and orchestration platform",
  "license": "BSL-1.1",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:gateway": "bun --watch apps/gateway/src/main.ts",
    "dev:ui": "bun run --cwd apps/ui dev",
    "build": "turbo build",
    "build:ui": "bun run --cwd apps/ui build",
    "start": "bun run --cwd apps/gateway start",
    "test": "bun vitest run",
    "test:unit": "bun vitest run --project unit",
    "test:e2e": "bun vitest run --project e2e",
    "test:watch": "bun vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@types/inquirer": "9.0.9",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "turbo": "^2.9.18",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "6.4.3",
    "vitest": "^3.2.6",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@opentelemetry/context-async-hooks": "2.7.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.2",
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.4",
    "tmp": "^0.2.6",
    "vite": "6.4.3"
  }
}
