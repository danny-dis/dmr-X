{
  "mcpEnabled": true,
  "aggregation": {
    "enabled": false,
    "servers": [
      {
        "id": "filesystem",
        "name": "Demo Filesystem",
        "transport": "stdio",
        "command": "bun",
        "args": [
          "x",
          "@modelcontextprotocol/server-filesystem",
          "/demo-data"
        ],
        "timeoutMs": 30000,
        "maxRetries": 3
      }
    ]
  },
  "guardrails": {
    "enabled": true,
    "pii": {
      "enabled": true,
      "maskChar": "*"
    },
    "contentFilter": {
      "enabled": true,
      "blockedPatterns": []
    }
  },
  "audit": {
    "enabled": true,
    "backend": "sqlite",
    "retentionDays": 30,
    "logBodies": false
  },
  "a2a": {
    "enabled": true,
    "agentCard": {
      "name": "DMR-X Agent",
      "description": "DMR-X MCP Server with intelligent routing",
      "version": "0.5.0",
      "url": "http://localhost:3100"
    }
  },
  "federation": {
    "enabled": true,
    "discovery": {
      "mdns": true,
      "dns": {
        "domain": ""
      }
    },
    "syncInterval": "5m"
  }
}