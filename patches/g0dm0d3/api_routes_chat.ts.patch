+/**
+ * Safely coerce a chat message `content` into a string.
+ *
+ * The OpenAI-compatible message schema (and DMR-X's dmrx_chat MCP tool)
+ * allows `content` to be either a string OR an array of multimodal parts
+ * (e.g. `[{ type: 'text', text: '...' }, { type: 'image_url', ... }]`).
+ * Naively calling `String(content)` on an array of objects collapses it to
+ * `"[object Object]"`, which then reaches the model as the literal prompt and
+ * triggers a bogus "MALFORMED QUERY DETECTED" hallucination instead of a real
+ * answer. Flatten array parts to their text; JSON-stringify anything else.
+ */
+function coerceContent(content: unknown): string {
+  if (typeof content === 'string') return content
+  if (content == null) return ''
+  if (Array.isArray(content)) {
+    return content
+      .map((part) => {
+        if (part == null) return ''
+        if (typeof part === 'string') return part
+        // OpenAI multimodal part: { type: 'text', text: '...' }
+        if (typeof part === 'object' && 'text' in (part as any)) {
+          return String((part as any).text ?? '')
+        }
+        // image_url / input_audio / unknown part — keep a readable note, never [object Object]
+        const type = (part as any)?.type ?? 'part'
+        return `[${type}]`
+      })
+      .join(' ')
+  }
+  if (typeof content === 'object') return JSON.stringify(content)
+  return String(content)
+}
