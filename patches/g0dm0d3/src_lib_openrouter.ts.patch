  * Routes requests to multiple AI models via OpenRouter
  */
 
-const OPENROUTER_API_URL = 'https://openrouter.ai/api/v1/chat/completions'
 const VENICE_API_URL = 'https://api.venice.ai/api/v1/chat/completions'
 
+/**
+ * Upstream chat endpoint. In relay mode (DMR-X internal proxy) this points at
+ * G0DM0D3_LLM_BASE_URL instead of OpenRouter, so the host gateway owns
+ * provider selection and key rotation. Resolved per call because the env is
+ * set by the parent process at spawn time.
+ */
+function openrouterApiUrl(): string {
+  const base = (process.env.G0DM0D3_LLM_BASE_URL || '').replace(/\/+$/, '')
+  if (!base) return 'https://openrouter.ai/api/v1/chat/completions'
+  return /\/chat\/completions$/.test(base) ? base : `${base}/chat/completions`
+}
+
+function isRelay(): boolean {
+  return process.env.GODMODE_RELAY === '1' || !!process.env.G0DM0D3_LLM_BASE_URL
+}
+
+/** Upstream headers; OpenRouter attribution is omitted when relaying. */
+function upstreamHeadersFor(apiKey: string): Record<string, string> {
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' }
+  if (apiKey) headers['Authorization'] = `Bearer ${apiKey}`
+  if (!isRelay()) {
+    headers['HTTP-Referer'] = 'https://godmod3.ai'
+    headers['X-Title'] = 'GODMOD3.AI'
+  }
+  return headers
+}
+
