+// DMR-X full tool pipeline: transform prose while protecting coding payloads.
+export function transformCodingProse(content: string, transform: (text: string) => string): string {
+  // Structured JSON is data, not prose (including whole JSON strings/arrays).
+  try { JSON.parse(content); return content } catch {}
+  const protectedRegions = /(```[\s\S]*?(?:```|$)|~~~[\s\S]*?(?:~~~|$)|`+[^`\n]*`+|(?:https?:\/\/|[A-Za-z]:[\\/]|\.{0,2}\/|\b[\w.-]+[\\/])[^\s<>]+|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')/g
+  return content.split(protectedRegions).map((part, index) => index % 2 ? part : transform(part)).join('')
+}
