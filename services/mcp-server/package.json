    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dmr-x/core": "*",
    "@dmr-x/mcp-client": "*",
    "@dmr-x/router": "*",
    "@dmr-x/adapters": "*",
    "@dmr-x/telemetry": "*",
    "@dmr-x/tool-search": "*",
    "@dmr-x/policy": "*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
