{
  "name": "@dmr-x/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dmrx-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -b",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dmr-x/core": "*",
    "@dmr-x/router": "*",
    "@dmr-x/adapters": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
