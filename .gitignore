# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build artifacts ────────────────────────────────────────────────────────
dist/
**/dist/
build/
coverage/
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# ─── Compiled TypeScript output (alongside source .ts files) ───────────────
# Note: legitimate JS-only configs (postcss/tailwind) are whitelisted below.
*.js
*.js.map
*.d.ts
*.d.ts.map

# ─── Stale Bun incremental emit inside src/ folders ───────────────────────
# Belt-and-suspenders: the global patterns above already cover these, but
# pinning them to src/ documents the intent (Bun's watch-mode emit
# creates .js/.d.ts/.js.map beside .ts sources).
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.js.map
# The UI's Vite environment types are a checked-in source file, not stale
# emit — un-ignore so a fresh clone can typecheck (B4).
!apps/ui/src/vite-env.d.ts

# ─── Legitimate JS config files (not compiled from .ts) ────────────────────
!apps/ui/postcss.config.js
!apps/ui/tailwind.config.js
!eslint.config.js

# ─── Turbo cache ────────────────────────────────────────────────────────────
.turbo/
**/.turbo/

# ─── Per-package UI build output ───────────────────────────────────────────
apps/gateway/public/

# ─── Environment / secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
*.err.log
# Root-level gateway debug logs (captured by hand during startup debugging)
gateway-*.log
gw-*.log

# ─── Local data / cache ─────────────────────────────────────────────────────
.data/
.dmrx-data/
# The MCP sidecar runs against its own database so it cannot clobber the
# gateway's (see DMRX_DATA_DIR in sidecar-boot.ts). It is encrypted at rest, so
# the *.db rules below do not match `data.db.enc` — it needs its own entry.
.dmrx-data-mcp/
*.db
*.db.enc
*.db.enc.lastgood
*.db-wal
*.db-shm

# ─── Agent tooling scratch ─────────────────────────────────────────────────
.hermes/

# ─── Ad-hoc QA / debug reports ──────────────────────────────────────────────
QA_REPORT_*.md
QA_*.md

# ─── Release artifacts (reproducible from scripts/package-release.sh) ──────
release/

# ─── Signed CLAs are not committed as plain text; only the template is ─────
cla/*.md

# ─── OS / IDE metadata ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.exe
*.png

# ─── Ad-hoc test fixtures ──────────────────────────────────────────────────
test-request*.json

# ─── Local persona keys (gitignored, never committed) ──────────────────────
# Real per-persona API keys live in scripts/persona_keys.local.cjs (imported
# by the seed script). The committed example is persona_keys.local.example.cjs.
scripts/persona_keys.local.cjs
*.local.cjs

# ─── Dev / debug artifacts (these are personal local scripts) ─────────────
.dbg/
scratch/
.tmp-*
*.bak
*.minimal
apply-schema-fix.ts
check-db-state.ts
sync-pollinations.ts
debug-*.md

# ─── Python (not used in this repo, but defensive) ─────────────────────────
__pycache__/
*.pyc
*.egg-info/
# needle-router venv + model checkpoints (large, regenerated locally)
services/needle-router/.venv/
services/needle-router/checkpoints/

# ─── AI-tool / IDE caches (regenerated on demand) ──────────────────────────
.claude/
.kilo/
.opencode/
.openclaude/
.gitnexus/
.chimera/
.mimocode/

# ─── Temp / local directories ─────────────────────────────────────────────
jan-repo/
temp-clawrouter/

# ─── Turbo / build output artifacts ───────────────────────────────────────
turbo-dry.json
turbo-output.txt

# ─── Ad-hoc debug / test output logs ──────────────────────────────────────
*-output.txt
*-log.txt
*-build*.txt
crypto-test.txt
unit-test-full.txt